#!/usr/bin/env node
// Fake `rsync` for the offline test suite: logs argv to $FAKE_LOG, copies nothing.
// `rsync -s --version` is the server's local protect-args probe: it succeeds
// (like GNU rsync 3.x) unless FAKE_RSYNC_NO_S=1 (like macOS openrsync), and is
// not logged as a transfer.
const { appendFileSync } = require('node:fs');
const argv = process.argv.slice(2);
if (argv.includes('--version')) {
  if (process.env.FAKE_RSYNC_NO_S === '1' && argv.includes('-s')) {
    process.stderr.write('rsync: invalid option -- s\n');
    process.exit(1);
  }
  process.stdout.write('rsync  version 3.2.7  protocol version 31\n');
  process.exit(0);
}
if (process.env.FAKE_RSYNC_NO_S === '1' && argv.includes('-s')) {
  process.stderr.write('rsync: invalid option -- s\n');
  process.exit(1);
}
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, JSON.stringify({ kind: 'rsync', argv }) + '\n');
process.stdout.write('sending incremental file list\n\nsent 120 bytes  received 35 bytes  310.00 bytes/sec\ntotal size is 42  speedup is 0.27\n');
