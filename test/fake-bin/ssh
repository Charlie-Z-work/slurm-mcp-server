#!/usr/bin/env node
// Fake `ssh` for the offline test suite. It never touches the network: it
// logs the call to $FAKE_LOG (one JSON object per line) and answers the remote
// command with output copied from a real SLURM cluster.
//
// Scenarios ($FAKE_SCENARIO): normal (default) | array | cancelled_by |
// master_dead | master_unconfigured | sbatch_fail | sacct_disabled (every sacct
// fails like on a site without Slurm accounting).
// Extra knobs (env, all optional):
//   FAKE_SCENARIO_BY_HOST=hostA:master_dead,hostB:normal  per-host scenario
//                               (overrides FAKE_SCENARIO for those hosts)
//   FAKE_SBATCH_ERR=gres        sbatch_fail reports a GPU/gres error instead
//                               of an account error
//   FAKE_SACCT_MISSING=id,id    the poll sacct does not report these job ids
//   FAKE_DEAD_HOSTS=a,b         `ssh -O check <host>` fails for these hosts
//   FAKE_RESOURCE_HISTORY=rows|fail   resource-history sacct queries return
//                               real-shaped rows (MaxRSS only on step rows) or fail
//   FAKE_STDOUT=placeholder|empty     sacct StdOut returns an unexpanded
//                               "%j" pattern / nothing
//   FAKE_SCONTROL_STDOUT=<path> scontrol show job reports this StdOut
//   FAKE_LS_EXISTS=<path>       `ls` of candidate log paths finds only this one
//   FAKE_SQUEUE_FAIL=1          `squeue -j` fails like for a finished job
//   FAKE_SACCTMGR_FAIL=1        sacctmgr fails (slurmdbd unreachable)
//   FAKE_CONTROLPATH=<path>|none   what `ssh -G` reports as controlpath
//                               (default /tmp/fake-cm/<host>)
//   FAKE_DELAY_MS=<ms>          remote commands (not `-O check`) sleep this long
//                               before answering (blocking-call tests)
//   FAKE_SSH_G_FAIL=1           `ssh -G` exits 255 (unreadable ssh config)
//   FAKE_DEAD_FILE=<path>       master is dead while this file exists
//                               (outage → reconnect within one server's life)
//   FAKE_RUNNING_UNTIL=<path>   plain jobs report RUNNING until this file exists
//   FAKE_SACCT_PAD_MB=<n>       the poll sacct appends ~n MB of step rows
//                               (huge array jobs)
//   FAKE_STDOUT=null            sacct StdOut reports "(null)"
// Array state machine: sacct reports task 2 RUNNING until either the file named
// by $FAKE_ARRAY_GATE exists (deterministic mode for tests) or, when no gate is
// set, until the second sacct poll.
const { appendFileSync, existsSync, readFileSync, writeFileSync, writeSync } = require('node:fs');

const argv = process.argv.slice(2);
// Host: `ssh -O check <host>` or `ssh [opts] <host> <command>`.
const oi = argv.indexOf('-O');
const host = argv[0] === '-G' ? argv[1] : oi >= 0 ? argv[oi + 2] : argv[argv.length - 2];
const byHost = Object.fromEntries((process.env.FAKE_SCENARIO_BY_HOST || '').split(',').filter(Boolean).map(kv => kv.split(':')));
const scenario = byHost[host] || process.env.FAKE_SCENARIO || 'normal';
const LOG = process.env.FAKE_LOG;

function readStdin() {
  try { return readFileSync(0, 'utf8'); } catch { return ''; }
}
function log(entry) {
  if (LOG) appendFileSync(LOG, JSON.stringify({ scenario, argv, ...entry }) + '\n');
}
// Synchronous full write: process.exit right after an async pipe write can
// truncate multi-MB output (the G4 large-sacct tests).
function writeAll(fd, str) {
  const buf = Buffer.from(str);
  let off = 0;
  while (off < buf.length) {
    try { off += writeSync(fd, buf, off); } catch (e) {
      if (e.code !== 'EAGAIN') throw e;
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 2);
    }
  }
}
function out(text, code = 0, err = '') {
  if (text) writeAll(1, text.endsWith('\n') ? text : text + '\n');
  if (err) process.stderr.write(err.endsWith('\n') ? err : err + '\n');
  process.exit(code);
}

// --- Config dump: ssh -G <host> (local only; real ssh prints the expanded
// ControlPath). Unconfigured hosts report "controlpath none". ---
if (argv[0] === '-G') {
  log({ kind: 'config' });
  if (process.env.FAKE_SSH_G_FAIL === '1') out('', 255, 'ssh: /home/u/.ssh/config line 3: Bad configuration option: bogus');
  const h = argv[1];
  const sc = byHost[h] || process.env.FAKE_SCENARIO || 'normal';
  if (process.env.FAKE_CONTROLPATH === 'none' || sc === 'master_unconfigured') out('hostname x\ncontrolpath none\n');
  out(`hostname x\ncontrolmaster auto\ncontrolpath ${process.env.FAKE_CONTROLPATH || `/tmp/fake-cm/${h}`}\nproxyjump bastion\n`);
}

// --- Control-master probe: ssh -O check <host> ---
if (oi >= 0) {
  const op = argv[oi + 1];
  log({ kind: 'control', op });
  const dead = (process.env.FAKE_DEAD_HOSTS || '').split(',').filter(Boolean);
  const deadFile = process.env.FAKE_DEAD_FILE;
  if (scenario === 'master_dead' || dead.includes(host) || (deadFile && existsSync(deadFile))) {
    out('', 255, 'Control socket connect(/tmp/cm-fake): No such file or directory');
  }
  if (scenario === 'master_unconfigured') {
    // Real OpenSSH message when no ControlPath is configured for the host.
    out('', 255, 'No ControlPath specified for "-O" command');
  }
  out('', 0, 'Master running (pid=1)');
}

// --- Remote command: last argument ---
if (Number(process.env.FAKE_DELAY_MS) > 0) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Number(process.env.FAKE_DELAY_MS));
}
const last = argv[argv.length - 1] || '';
let cmd = last;
let wrapped = false;
const m = last.match(/^bash --login -c '([\s\S]*)'$/);
if (m) { cmd = m[1].replace(/'"'"'/g, "'"); wrapped = true; }

// ssh_write_file pipes the content on stdin: `cat > '/path'` / `cat >> '/path'`.
const w = !wrapped && cmd.match(/^cat (>>?) '([\s\S]*)'$/);
if (w) {
  const data = readStdin();
  log({ kind: 'write', cmd, op: w[1], path: w[2].replace(/'"'"'/g, "'"), bytes: Buffer.byteLength(data) });
  out('');
}
log({ kind: 'exec', cmd, wrapped });

const stateFile = LOG ? `${LOG}.array-calls` : null;
const JOB_IDS = { normal: '541806', array: '541822', cancelled_by: '541900' };

function sacctPollRows(ids) {
  const rows = [];
  const missing = (process.env.FAKE_SACCT_MISSING || '').split(',').filter(Boolean);
  for (const id of ids) {
    if (missing.includes(id)) continue;
    if (scenario === 'array' && id === '541822') {
      let calls = 0;
      if (stateFile && existsSync(stateFile)) calls = +readFileSync(stateFile, 'utf8') || 0;
      calls++;
      if (stateFile) writeFileSync(stateFile, String(calls));
      const gate = process.env.FAKE_ARRAY_GATE;
      const done = gate ? existsSync(gate) : calls >= 2;
      rows.push('541822_1|COMPLETED', '541822_1.batch|COMPLETED', '541822_1.extern|COMPLETED');
      if (done) rows.push('541822_2|COMPLETED', '541822_2.batch|COMPLETED', '541822_2.extern|COMPLETED');
      else rows.push('541822_2|RUNNING', '541822_2.batch|RUNNING', '541822_2.extern|RUNNING');
    } else if (scenario === 'cancelled_by' && id === '541900') {
      rows.push('541900|CANCELLED by 12345', '541900.batch|CANCELLED', '541900.extern|COMPLETED');
    } else if (process.env.FAKE_RUNNING_UNTIL && !existsSync(process.env.FAKE_RUNNING_UNTIL)) {
      rows.push(`${id}|RUNNING`, `${id}.batch|RUNNING`, `${id}.extern|RUNNING`);
    } else {
      rows.push(`${id}|COMPLETED`, `${id}.batch|COMPLETED`, `${id}.extern|COMPLETED`);
    }
  }
  const padMb = Number(process.env.FAKE_SACCT_PAD_MB) || 0;
  if (padMb > 0 && ids.length) {
    const pad = [];
    let bytes = 0;
    for (let i = 0; bytes < padMb * 1048576; i++) {
      const row = `${ids[0]}.${i}|COMPLETED`;
      pad.push(row);
      bytes += row.length + 1;
    }
    for (const row of pad) rows.push(row); // no spread: 300k+ arguments overflow the stack
  }
  return rows.join('\n');
}

const PARTITIONS = [
  'PartitionName=batch AllowGroups=ALL AllowAccounts=ALL AllowQos=ALL AllocNodes=ALL Default=YES QoS=N/A DefaultTime=NONE DisableRootJobs=NO ExclusiveUser=NO GraceTime=0 Hidden=NO MaxNodes=UNLIMITED MaxTime=2-00:00:00 MinNodes=0 LLN=NO MaxCPUsPerNode=UNLIMITED Nodes=bcm-dgxa100-[0002-0003,0005-0020] PriorityJobFactor=1 PriorityTier=1 RootOnly=NO ReqResv=NO OverSubscribe=NO OverTimeLimit=NONE PreemptMode=OFF State=UP TotalCPUs=4608 TotalNodes=18',
  'PartitionName=short AllowGroups=ALL AllowAccounts=ALL AllowQos=ALL AllocNodes=ALL Default=NO QoS=shortqos DefaultTime=NONE DisableRootJobs=NO ExclusiveUser=NO GraceTime=0 Hidden=NO MaxNodes=UNLIMITED MaxTime=04:00:00 MinNodes=0 LLN=NO MaxCPUsPerNode=UNLIMITED Nodes=bcm-dgxa100-[0001,0004] PriorityJobFactor=1 PriorityTier=1 RootOnly=NO ReqResv=NO OverSubscribe=NO OverTimeLimit=NONE PreemptMode=OFF State=UP TotalCPUs=512 TotalNodes=2',
];
const QOS = { shortqos: { Name: 'shortqos', MaxJobsPU: '1', MaxSubmitPU: '', MaxTRESPU: 'cpu=32,gres/gpu=2,mem=256G', MaxWall: '' } };

let r;
if (scenario === 'sacct_disabled' && /^sacct\b/.test(cmd)) {
  // Real message on a site with AccountingStorageType=accounting_storage/none.
  out('', 1, 'sacct: error: Slurm accounting storage is disabled');
}
if (/\|\s*sbatch\b/.test(cmd) || /^sbatch\s/.test(cmd)) {
  if (scenario === 'sbatch_fail') {
    if (process.env.FAKE_SBATCH_ERR === 'gres') out('', 1, 'sbatch: error: Invalid generic resource (gres) specification');
    out('', 1, 'sbatch: error: Batch job submission failed: Invalid account or account/partition combination specified');
  }
  out(`Submitted batch job ${JOB_IDS[scenario] || '541806'}`);
} else if ((r = cmd.match(/^sacct -j ([\d,]+) --format=JobID%-20,State -P -n$/))) {
  out(sacctPollRows(r[1].split(',')));
} else if (/^sacct -u \S+ -X /.test(cmd)) {
  // resource history step 1: recent allocations of this user
  const rh = process.env.FAKE_RESOURCE_HISTORY;
  if (rh === 'fail') out('', 1, 'sacct: error: Problem talking to the database: Connection refused');
  if (rh === 'rows') {
    out(['541700|other|COMPLETED', '541806|train|COMPLETED', '541807|Train-big|COMPLETED',
      '541808|train|FAILED', '541809_1|train|COMPLETED', '541810+0|train-het|COMPLETED'].join('\n'));
  }
  out('');
} else if ((r = cmd.match(/^sacct -j ([\d_+,]+) -o JobID%-20,JobName%-20,Elapsed,MaxRSS,ReqMem,State -P -n$/))) {
  // resource history step 2: every row incl. steps. As on the real cluster,
  // the allocation row has an empty MaxRSS; only steps carry it.
  if (process.env.FAKE_RESOURCE_HISTORY === 'fail') out('', 1, 'sacct: error: Problem talking to the database: Connection refused');
  const rows = {
    541806: ['541806|train|00:10:00||4G|COMPLETED', '541806.batch|batch|00:10:00|1.50G||COMPLETED', '541806.extern|extern|00:10:00|1024K||COMPLETED'],
    541807: ['541807|Train-big|01:00:00||8G|COMPLETED', '541807.batch|batch|01:00:00|3G||COMPLETED', '541807.extern|extern|01:00:00|0||COMPLETED'],
    '541809_1': ['541809_1|train|00:05:00||4G|COMPLETED', '541809_1.batch|batch|00:05:00|512M||COMPLETED'],
    '541810+0': ['541810+0|train-het|00:02:00||4G|COMPLETED', '541810+0.batch|batch|00:02:00|256M||COMPLETED'],
  };
  out(r[1].split(',').flatMap(id => rows[id] || []).join('\n'));
} else if ((r = cmd.match(/^sacct -j '([^']+)' --format=StdOut/))) {
  if (process.env.FAKE_STDOUT === 'placeholder') out('/home/u/proj/results/logs/slurm_%j.out');
  if (process.env.FAKE_STDOUT === 'empty') out('');
  if (process.env.FAKE_STDOUT === 'null') out('(null)');
  out(`/home/u/proj/results/logs/slurm_${r[1]}.out`);
} else if (/^scontrol show job -o '/.test(cmd)) {
  // One-line records as printed by `scontrol show job -o`, one per path
  // (an array base id prints one record per task).
  const paths = (process.env.FAKE_SCONTROL_STDOUT || '').split('\n').filter(Boolean);
  out(paths.map((p, i) => `JobId=${541822 + i} JobName=x UserId=u(1) JobState=COMPLETED WorkDir=/w StdErr=${p} StdIn=/dev/null StdOut=${p} Power= TresPerNode=gres/gpu:1`).join('\n'));
} else if (/^squeue -j /.test(cmd) && process.env.FAKE_SQUEUE_FAIL === '1') {
  out('', 1, 'slurm_load_jobs error: Invalid job id specified');
} else if (/^sacctmgr /.test(cmd) && process.env.FAKE_SACCTMGR_FAIL === '1') {
  out('', 1, 'sacctmgr: error: Problem talking to the database: Connection refused');
} else if ((r = cmd.match(/^grep -iF -e (\S+) (\S+); test \$\? -le 1$/))) {
  // HPC_RESOURCE_LOG lookup: grep exit 2 (missing file) makes the command fail.
  if (/missing/.test(r[2])) out('', 1, `grep: ${r[2]}: No such file or directory`);
  out(`${r[1]}\t2.1G\t00:12:00\tseed=1`);
} else if (/^ls '/.test(cmd) && /slurm[_-]/.test(cmd)) {
  // log-file lookup: `ls '<cand1>' '<cand2>' ... 2>/dev/null | head -1`
  const want = process.env.FAKE_LS_EXISTS;
  const cands = [...cmd.matchAll(/'([^']+)'/g)].map(x => x[1]);
  out(want && cands.includes(want) ? want : '');
} else if ((r = cmd.match(/^sacct -j '([^']+)'$/))) {
  out(['JobID           JobName  Partition    Account  AllocCPUS      State ExitCode',
    '------------ ---------- ---------- ---------- ---------- ---------- --------',
    `${r[1]}          train      batch       acct          8  COMPLETED      0:0`].join('\n'));
} else if (/\|\s*wc -l$/.test(cmd) && /^squeue\b/.test(cmd)) {
  out(process.env.FAKE_SQUEUE_COUNT || '0');
} else if (/^squeue\b/.test(cmd)) {
  out('             JOBID PARTITION     NAME     USER ST       TIME  NODES NODELIST(REASON)');
} else if (/^sinfo -s$/.test(cmd)) {
  out(['PARTITION AVAIL  TIMELIMIT   NODES(A/I/O/T) NODELIST',
    'batch*       up 2-00:00:00        15/0/3/18 bcm-dgxa100-[0002-0003,0005-0020]',
    'short        up    4:00:00          2/0/0/2 bcm-dgxa100-[0001,0004]'].join('\n'));
} else if (/^scontrol show partition\b/.test(cmd)) {
  if (/\s-o\b/.test(cmd)) out(PARTITIONS.join('\n'));
  out(PARTITIONS.map(p => p.split(' ').join('\n   ')).join('\n\n'));
} else if ((r = cmd.match(/^sacctmgr show qos where name=(\S+) -P -n format=(\S+)$/))) {
  const fields = r[2].split(',');
  out(r[1].split(',').filter(n => QOS[n]).map(n => fields.map(f => QOS[n][f] ?? '').join('|')).join('\n'));
} else if (/^hostname$/.test(cmd)) {
  out('slogin-01');
} else if ((r = cmd.match(/^scancel '([^']+)' && echo "(.*)"$/))) {
  out(r[2]);
} else if (/^(tail|head) -n \d+ '/.test(cmd) || /^cat '/.test(cmd)) {
  out('epoch 1 loss 0.9\nepoch 2 loss 0.5');
} else if (/^ls\b/.test(cmd) || /(&&|;)\s*ls\b/.test(cmd)) {
  out('a.txt\nb.txt');
} else {
  out(''); // mkdir, cd, rm, ...: silent success
}
