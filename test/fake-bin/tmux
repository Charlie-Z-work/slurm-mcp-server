#!/usr/bin/env node
// Fake `tmux` for the offline test suite: logs argv to $FAKE_LOG, touches no
// real tmux server. capture-pane answers with a fixed pane.
const { appendFileSync } = require('node:fs');
const argv = process.argv.slice(2);
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, JSON.stringify({ kind: 'tmux', argv }) + '\n');
if (argv[0] === 'capture-pane') process.stdout.write('$ fake pane\n');
if (argv[0] === 'kill-session' && process.env.FAKE_TMUX_NO_SESSION === '1') {
  process.stderr.write("can't find session\n");
  process.exit(1);
}
